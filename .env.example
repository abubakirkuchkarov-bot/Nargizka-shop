# Скопируйте в .env локально или задайте в Vercel → Settings → Environment Variables.
# Реальные значения НИКОГДА не коммитьте в GitHub.
PORT=3001

# Turso (обязательно в Production). Без них локально используется файл data/local.sqlite
TURSO_DATABASE_URL=libsql://nargizka-shop-<ваш-аккаунт>.turso.io
TURSO_AUTH_TOKEN=

# Пароль администратора при первом входе (в Production — не короче 10 символов).
# После смены пароля в админке действует новый пароль из базы, эта переменная больше не используется.
ADMIN_PASSWORD=

# Секрет подписи сессий: случайная строка не короче 32 символов (обязательно в Production).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
